---
import closeIcon from "../assets/images/icons/close.svg";

type Props = {
  imageSrc: string;
  alt: string;
  caption?: string;
  class?: string;
  "aria-label"?: string;
};

const {
  imageSrc,
  alt,
  caption,
  class: className = "contents cursor-pointer",
  "aria-label": ariaLabel,
} = Astro.props;
---

<image-lightbox class="contents">
  <button
    type="button"
    class={className}
    aria-label={ariaLabel}
    data-lightbox-open
  >
    <slot />
  </button>

  <dialog
    class="p-0 bg-transparent border-none backdrop:bg-black/80 backdrop:backdrop-blur-sm open:flex open:items-center open:justify-center w-full h-full max-w-full max-h-full fixed inset-0"
  >
    {/* Backdrop to close the dialog */}
    <button
      type="button"
      class="fixed inset-0 w-full h-full cursor-default"
      aria-label="Close lightbox"
      data-lightbox-close
    ></button>

    <div
      class="relative flex items-center justify-center w-full h-full p-4 pointer-events-none"
    >
      <button
        type="button"
        class="fixed top-4 right-4 text-white hover:text-gray-300 z-50 cursor-pointer pointer-events-auto"
        aria-label="Close"
        data-lightbox-close
      >
        <img src={closeIcon.src} width="32" height="32" alt="" />
      </button>

      <div
        class="max-w-[90vw] max-h-[90vh] flex flex-col items-center pointer-events-auto"
      >
        <img
          src={imageSrc}
          alt={alt}
          class="w-full h-full object-contain shadow-2xl"
        />
        {caption && (
          <p class="text-white mt-4 text-center text-sm md:text-base bg-black/40 px-4 py-2 rounded-lg backdrop-blur-sm select-none">
            {caption}
          </p>
        )}
      </div>
    </div>
  </dialog>
</image-lightbox>

<style is:global>
body:has(dialog[open]) {
  overflow: hidden;
}
</style>

<script>
class ImageLightbox extends HTMLElement {
  connectedCallback() {
    const dialog = this.querySelector("dialog");
    if (!dialog) return;

    this.querySelector("[data-lightbox-open]")?.addEventListener("click", () =>
      dialog.showModal()
    );
    for (const button of this.querySelectorAll("[data-lightbox-close]")) {
      button.addEventListener("click", () => dialog.close());
    }
  }
}

customElements.define("image-lightbox", ImageLightbox);
</script>
