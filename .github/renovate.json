{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", "mergeConfidence:all-badges"],
  "reviewersFromCodeOwners": true,
  "minimumReleaseAge": "14 days",
  "prCreation": "not-pending",
  "timezone": "Asia/Tokyo",
  "schedule": ["* 0-4 * * *"],
  "packageRules": [
    {
      "description": "align npm minimumReleaseAge with pnpm-workspace.yaml (overrides 3 days from security:minimumReleaseAgeNpm).",
      "matchDatasources": ["npm"],
      "minimumReleaseAge": "14 days"
    },
    {
      "description": "automerge minor, patch and digest updates.",
      "matchUpdateTypes": ["minor", "patch", "digest", "pinDigest"],
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "description": "group minor and patch updates of npm dependencies.",
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "npm dependencies (non-major)",
      "groupSlug": "npm-deps-non-major"
    },
    {
      "description": "group minor and patch updates of npm devDependencies.",
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "npm devDependencies (non-major)",
      "groupSlug": "npm-dev-deps-non-major"
    },
    {
      "description": "group minor, patch and digest updates of GitHub Actions.",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pinDigest"],
      "groupName": "GitHub Actions (non-major)",
      "groupSlug": "github-actions-non-major"
    },
    {
      "description": "major updates for manual intervention.",
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ],
  "lockFileMaintenance": {
    "automerge": true,
    "platformAutomerge": true
  }
}
