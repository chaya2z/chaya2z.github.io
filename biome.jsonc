{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/*.yml", // Ignore unsupported (in progress) file types
      "!**/*.yaml",
      "!**/*.md"
    ]
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      // Astro rules are still in nursery, so enable them explicitly
      "nursery": {
        "noAstroConflictingSetDirectives": "error",
        "noAstroSetHtmlDirective": "error",
        "useAstroClientOnlyDirectiveValue": "error"
      }
    }
  },
  "assist": {
    "actions": {
      "preset": "recommended",
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "formatter": {
    "indentStyle": "space"
  },
  "javascript": {
    "formatter": {
      "trailingCommas": "es5"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "html": {
    // Enable lint and format for .astro files
    "experimentalFullSupportEnabled": true,
    "formatter": {
      "enabled": true,
      "selfCloseVoidElements": "always"
    }
  },
  "overrides": [
    {
      // SVG files are loaded via <img>, so alt text belongs to the <img> element
      "includes": ["**/*.svg"],
      "linter": {
        "rules": {
          "a11y": {
            "noSvgWithoutTitle": "off"
          }
        }
      }
    }
  ]
}
